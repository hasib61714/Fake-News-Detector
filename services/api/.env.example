# Copy to services/api/.env. Contains no secrets; all values are safe defaults.

# development | production
APP_ENV=development

# Path to the trained model artifact (resolved relative to the working directory,
# which is services/api when started via `make api`). Produced by `make train`.
MODEL_PATH=../../ml/artifacts/model.joblib

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# When true, exposes POST /api/v1/demo/analyze, which returns a fixed, clearly
# labeled sample result. It never runs the ML model. Leave false in production.
ENABLE_DEMO_MODE=false
