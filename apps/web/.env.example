# Copy to apps/web/.env.local. Contains no secrets.
#
# Base URL of the FastAPI backend, as reachable from the user's BROWSER.
# NEXT_PUBLIC_* values are inlined at build time and visible to every visitor,
# so never put secrets here. Restart `npm run dev` / rebuild after changing it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
